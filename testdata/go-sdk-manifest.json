{
  "v": 1,
  "runtime": {
    "language": "go",
    "version": "1.27"
  },
  "workflow": {
    "name": "branching-demo",
    "max_concurrent_nodes": 5
  },
  "nodes": [
    {
      "key": "step_1",
      "entrypoint": "app",
      "execution": {
        "machine": "m"
      },
      "io": {
        "output": {
          "shape": "value",
          "content_type": "application/json",
          "schema": {}
        }
      }
    },
    {
      "key": "step_2",
      "entrypoint": "app",
      "depends": [
        "step_1"
      ],
      "retry": {
        "max_attempts": 2,
        "initial_backoff_ms": 1000
      },
      "execution": {
        "machine": "m",
        "timeout_ms": 30000
      },
      "io": {
        "output": {
          "shape": "value",
          "content_type": "application/json",
          "schema": {}
        }
      }
    },
    {
      "key": "report",
      "entrypoint": "app",
      "depends": [
        "step_2"
      ],
      "external_depends": [
        "crunch"
      ],
      "io": {
        "output": {
          "shape": "value",
          "content_type": "application/json",
          "schema": {}
        }
      }
    }
  ]
}
